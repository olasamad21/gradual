rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile: only the signed-in user can read/write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /concepts_software_engineering/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /daily_sets_software_engineering/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Concepts and daily sets fallback
    match /{collectionId}/{docId} {
      allow read: if request.auth != null
        && (collectionId.matches('concepts_.*')
            || collectionId.matches('daily_sets_.*'));
      allow write: if false;
    }
  }
}
